{
  "platform": "linkedin",
  "displayName": "LinkedIn",
  "authType": "oauth2",
  "contentLimits": {
    "modes": ["text", "image_text", "video"],
    "maxTitleLength": 200,
    "maxBodyLength": 3000,
    "maxImages": 9,
    "maxVideos": 1,
    "allowMixedMedia": false
  },
  "mediaRules": {
    "imageFormats": ["jpg", "jpeg", "png", "gif"],
    "videoFormats": ["mp4"],
    "maxImageSizeBytes": 10485760,
    "maxVideoSizeBytes": 209715200,
    "maxVideoDurationSec": 600
  },
  "topic": {
    "supported": false,
    "nativeField": false
  },
  "publishPolicy": {
    "completionStrategy": "sync",
    "scheduleByPlatform": false,
    "updateSupported": false
  }
}
