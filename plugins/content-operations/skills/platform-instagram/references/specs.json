{
  "platform": "instagram",
  "displayName": "Instagram",
  "authType": "oauth2",
  "contentLimits": {
    "modes": ["image_text", "video"],
    "maxBodyLength": 2200,
    "maxImages": 10,
    "maxVideos": 1,
    "allowMixedMedia": false
  },
  "mediaRules": {
    "imageFormats": ["jpg", "jpeg"],
    "videoFormats": ["mp4", "mov"],
    "maxImageSizeBytes": 8388608,
    "maxVideoSizeBytes": 314572800,
    "minVideoDurationSec": 3,
    "maxVideoDurationSec": 900,
    "aspectRatio": {
      "min": 0.8,
      "max": 1.91
    }
  },
  "topic": {
    "supported": true,
    "nativeField": false,
    "maxCount": 30
  },
  "publishPolicy": {
    "completionStrategy": "polling",
    "scheduleByPlatform": false,
    "updateSupported": false
  }
}
