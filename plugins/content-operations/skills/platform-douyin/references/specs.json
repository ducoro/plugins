{
  "platform": "douyin",
  "displayName": "Douyin",
  "authType": "oauth2_or_browser",
  "contentLimits": {
    "modes": ["image_text", "video"],
    "maxTitleLength": 30,
    "maxBodyLength": 1000,
    "maxTotalTextLength": 1000,
    "maxImages": 12,
    "maxVideos": 1,
    "allowMixedMedia": false
  },
  "mediaRules": {
    "imageFormats": ["jpg", "jpeg", "png", "bmp", "webp"],
    "videoFormats": ["mp4", "avi", "mkv", "mov"],
    "maxImageSizeBytes": 20971520,
    "maxVideoSizeBytes": 4294967296,
    "maxVideoDurationSec": 900
  },
  "apiOverrides": {
    "mediaRules": {
      "imageFormats": ["jpg", "jpeg", "png", "bmp"],
      "maxVideoSizeBytes": 104857600
    }
  },
  "topic": {
    "supported": true,
    "nativeField": true
  },
  "recommendations": {
    "maxTopicCount": 5,
    "coverAspectRatio": {
      "min": 0.54,
      "max": 1.85
    }
  },
  "publishPolicy": {
    "completionStrategy": "user_handoff_or_browser",
    "scheduleByPlatform": true,
    "updateSupported": false
  }
}
