{
  "platform": "facebook",
  "displayName": "Facebook Page",
  "authType": "oauth2",
  "contentLimits": {
    "modes": ["text", "image_text", "video"],
    "maxBodyLength": 63206,
    "maxImages": 10,
    "maxVideos": 1,
    "allowMixedMedia": false
  },
  "mediaRules": {
    "imageFormats": ["jpg", "jpeg", "png", "gif", "bmp", "tiff"],
    "videoFormats": ["mp4", "mov", "avi"],
    "maxImageSizeBytes": 10485760,
    "maxVideoSizeBytes": 1073741824,
    "maxVideoDurationSec": 3600
  },
  "topic": {
    "supported": true,
    "nativeField": false
  },
  "recommendations": {
    "maxTopicCount": 5
  },
  "publishPolicy": {
    "completionStrategy": "sync",
    "scheduleByPlatform": true,
    "updateSupported": false
  }
}
