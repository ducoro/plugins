{
  "platform": "wechat-official",
  "displayName": "WeChat Official Account",
  "authType": "oauth2",
  "contentLimits": {
    "modes": ["image_text", "newspic"],
    "maxTitleLength": 64,
    "maxBodyLength": 20000,
    "maxImages": 20,
    "maxVideos": 0,
    "allowMixedMedia": false,
    "newspicLimits": {
      "maxTitleLength": 32,
      "maxBodyLength": 1000,
      "minImages": 1,
      "maxImages": 20
    }
  },
  "mediaRules": {
    "imageFormats": ["jpg", "jpeg", "png", "gif", "bmp"],
    "maxImageSizeBytes": 10485760
  },
  "topic": {
    "supported": false,
    "nativeField": false
  },
  "recommendations": {
    "coverAspectRatio": {
      "min": 0.95,
      "max": 2.45
    }
  },
  "publishPolicy": {
    "completionStrategy": "polling",
    "scheduleByPlatform": false,
    "updateSupported": false
  }
}
