    "text": "#18181b",
    "textLight": "#52525b",
    "bg": "#fffdf9",
    "surface": "#f4f4f5",
    "codeBg": "#18181b",
    "codeText": "#fafafa",
    "inlineCodeBg": "#fee2e2",
    "inlineCodeText": "#b91c1c",
    "quoteBorder": "#1d4ed8",
    "quoteBg": "#eff6ff",
    "border": "#d4d4d8"
