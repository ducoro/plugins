#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
remote_name="${1:-origin}"
push_input=$(cat)

if [ -n "$push_input" ]; then
    printf '%s\n' "$push_input" | python3 "$repo_root/scripts/check_hygiene.py" --pre-push
fi
python3 "$repo_root/scripts/validate.py"

if [ "${ALLOW_PUSH:-0}" = "1" ]; then
    exit 0
fi

if [ -t 1 ] && [ -r /dev/tty ]; then
    echo ""
    echo "About to push to remote '$remote_name':"
    printf '%s\n' "$push_input" | while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
        [ -n "${local_sha:-}" ] || continue
        if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
            echo "  - delete $remote_ref"
        elif [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
            echo "  - new ref $local_ref -> $remote_ref"
            git -C "$repo_root" log --oneline --stat "$local_sha" --not --remotes | sed 's/^/      /'
        else
            echo "  - update $local_ref -> $remote_ref"
            git -C "$repo_root" log --oneline --stat "${remote_sha}..${local_sha}" | sed 's/^/      /'
        fi
    done
    printf "Confirm push to '%s'? [y/N]: " "$remote_name" > /dev/tty
    IFS= read -r reply < /dev/tty || reply=""
    case "$reply" in
        y|Y|yes|YES)
            exit 0
            ;;
        *)
            echo "Push cancelled." >&2
            exit 1
            ;;
    esac
fi

echo "Push blocked in non-interactive mode. Review commits and re-run with ALLOW_PUSH=1." >&2
exit 1
